% AAAI 2024 / ICWSM Conference Style File
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{aaai24}[2023/07/01 AAAI Style File]

\RequirePackage{times}
\RequirePackage{helvet}
\RequirePackage{courier}

\setlength{\paperheight}{11in}
\setlength{\paperwidth}{8.5in}
\setlength{\textheight}{9.0in}
\setlength{\textwidth}{7.0in}
\setlength{\topmargin}{-0.25in}
\setlength{\headheight}{0in}
\setlength{\headsep}{0in}
\setlength{\oddsidemargin}{-0.25in}
\setlength{\evensidemargin}{-0.25in}
\setlength{\columnsep}{0.25in}
\setlength{\parindent}{10pt}
\setlength{\parskip}{0pt}

\flushbottom \twocolumn \sloppy

\def\title#1{\gdef\@title{\textbf{\Large #1}}}
\def\author#1{\gdef\@author{#1}}
\def\affiliations#1{\gdef\@affiliations{#1}}
\gdef\@affiliations{}

\def\maketitle{\par
 \begingroup
   \def\thefootnote{\fnsymbol{footnote}}
   \def\@makefnmark{\hbox to 0pt{$^{\@thefnmark}$\hss}}
   \twocolumn[\@maketitle]
   \@thanks
 \endgroup
 \setcounter{footnote}{0}
 \let\maketitle\relax \let\@maketitle\relax
 \gdef\@thanks{}\gdef\@author{}\gdef\@title{}\gdef\@affiliations{}\let\thanks\relax
}

\def\@maketitle{
  \vbox to 1.8in{
    \hsize\textwidth
    \linewidth\hsize
    \vfil
    \centering
    {\LARGE\bf \@title \par}
    \vskip 0.2in
    {\def\and{\unskip\enspace{\rm and}\enspace}%
     \def\And{\end{tabular}\hss \egroup \hskip 1in plus 2fil 
              \hbox to 0pt\bgroup\hss \begin{tabular}[t]{c}\bf}%
     \def\AND{\end{tabular}\hss\egroup \hfil\hfil\egroup
              \vskip 0.15in
              \hbox to \linewidth\bgroup\large \hfil\hfil
                \hbox to 0pt\bgroup\hss \begin{tabular}[t]{c}\bf}
     \hbox to \linewidth\bgroup\large \hfil\hfil
       \hbox to 0pt\bgroup\hss \begin{tabular}[t]{c}\bf\@author 
                            \end{tabular}\hss\egroup
       \hfil\hfil\egroup}
    \vskip 0.08in
    {\normalsize \@affiliations \par}
    \vfil
  }
}

\renewenvironment{abstract}%
  {\centerline{\bf Abstract}\vspace{0.5ex}\begin{quote}\small}%
  {\par\end{quote}\vskip 1ex}

\def\section{\@startsection{section}{1}{\z@}%
  {-1.5ex plus -0.5ex minus -0.2ex}%
  {0.8ex plus 0.2ex}%
  {\normalfont\large\bfseries}}

\def\subsection{\@startsection{subsection}{2}{\z@}%
  {-1.2ex plus -0.3ex minus -0.2ex}%
  {0.5ex plus 0.2ex}%
  {\normalfont\normalsize\bfseries}}

\def\subsubsection{\@startsection{subsubsection}{3}{\z@}%
  {-1.0ex plus -0.2ex minus -0.1ex}%
  {0.3ex plus 0.1ex}%
  {\normalfont\normalsize\itshape}}

\pagestyle{empty}

\endinput
